through semantic tags, and Wallet doesn’t supersede it:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Flight information","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Semantic tag","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Boarding group","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"boardingGroup","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Boarding time","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"originalBoardingDate","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Passenger name","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"passengerName","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Seat","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"seats","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Sequence Number","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"boardingSequenceNumber","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"For the full list of semantic tags, see ","type":"text"},{"identifier":"doc:\/\/com.apple.walletpasses\/documentation\/WalletPasses\/SemanticTags","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"The information you provide determines the boarding time. Wallet calculates the boarding time by applying the time difference between your ","type":"text"},{"code":"originalDepartureDate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"originalBoardingDate","type":"codeVoice"},{"text":" to the known live departure time.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSecti